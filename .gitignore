# Mixamo assets — Adobe's terms forbid redistribution. Download Y Bot
# yourself and build the scene with pipeline/setup_rig.py (docs/INSTALL.md).
ybot.fbx
*.fbx
*_rest.blend
*.blend1
rig_profile.json

# The author's plates and produced clips are demonstration material,
# not part of the distributed pipeline. They stay local.
plates/
clips/

# Local reference material not meant to ship (rig measurement dumps etc.)
local/

# External tools: GVHMR checkout, its venv, checkpoints and the
# license-gated SMPL-X body model all live here. Never commit them.
tools/*

# The XPU fork carries these small source patches from GVHMR. Keep the
# checkout and assets ignored while allowing the patched runtime modules
# to be versioned.
!tools/GVHMR/
tools/GVHMR/*
!tools/GVHMR/hmr4d/
!tools/GVHMR/hmr4d/
!tools/GVHMR/hmr4d/utils/
!tools/GVHMR/hmr4d/utils/preproc/
!tools/GVHMR/hmr4d/model/
!tools/GVHMR/hmr4d/model/gvhmr/
!tools/GVHMR/hmr4d/utils/net_utils.py
!tools/GVHMR/hmr4d/utils/preproc/tracker.py
!tools/GVHMR/hmr4d/utils/preproc/vitpose.py
!tools/GVHMR/hmr4d/utils/preproc/vitfeat_extractor.py
!tools/GVHMR/hmr4d/model/gvhmr/gvhmr_pl_demo.py

# Local notes (session ids, scratch notes) — never published.
*.txt

# Python
__pycache__/
*.pyc

# Per-character rig measurements (setup_rig.py / setup_duo.py). Derived
# from your own Mixamo downloads, same as rig_profile.json above.
rig_profiles/
*.zip
